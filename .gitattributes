# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit source code files
*.cpp text eol=lf
*.h text eol=lf
*.ino text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf

# Binary files
*.bin binary
*.png binary
*.webp binary
*.zip binary
